# =============================================================================
# The Field Work — environment
# Copy to .env.local for local work. On Replit these go in the Secrets panel.
# NEVER commit a filled-in copy of this file.
# =============================================================================

# --- REQUIRED IN PRODUCTION --------------------------------------------------

# Signs the admin session cookie. Without it the portal refuses to start in
# production, on purpose: the alternative — inventing a random secret at boot —
# would sign everyone out on every restart and leave nobody able to explain why.
#
# Generate one with:   openssl rand -base64 32
AUTH_SECRET=

# --- OPTIONAL ----------------------------------------------------------------

# Where the admin credential is stored. Defaults to ./data next to the app.
#
# IMPORTANT: on Replit this must point at storage that survives a REDEPLOY.
# A Reserved VM keeps files across restarts, but a redeploy builds a fresh
# container — so if this is left at the default, changing the password and then
# redeploying puts the temporary password back. See docs/DECISIONS-BUILD.md D-10.
DATA_DIR=

# The admin username. Defaults to mariannevwillis.
ADMIN_USERNAME=

# The site's public origin, used for canonical URLs, share previews, the
# sitemap and links inside emails. Defaults to https://thefieldwork.co.uk.
NEXT_PUBLIC_SITE_URL=
