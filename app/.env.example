# =============================================================================
# The Field Work — environment
# Copy to .env.local for local work. On Replit these go in the Secrets panel.
# NEVER commit a filled-in copy of this file.
# =============================================================================

# --- REQUIRED IN PRODUCTION --------------------------------------------------

# Signs the admin session cookie. Without it the portal refuses to start in
# production, on purpose: the alternative — inventing a random secret at boot —
# would sign everyone out on every restart and leave nobody able to explain why.
#
# Generate one with:   openssl rand -base64 32
AUTH_SECRET=

# The Postgres connection. On Replit this is provided by the workspace's own
# database — nothing is hosted outside Replit. Locally, point it at a Postgres
# on your machine; the schema is identical, the data is not shared.
#
#   local example:  postgresql://tfw:devpass@localhost:5432/thefieldwork
#
# There is no fallback if this is missing: the app fails to start and says so.
# The store it replaced failed silently instead, which is how a redeploy kept
# resetting the admin password with nobody noticing.
DATABASE_URL=

# --- OPTIONAL ----------------------------------------------------------------

# The admin username — her email address; she signs in with it.
# Defaults to marianne@thefieldwork.co.uk.
ADMIN_USERNAME=

# Her email address — where reset links go. Defaults to
# marianne@thefieldwork.co.uk. Fills a blank, or corrects an address this code
# itself guessed earlier — never one she has chosen in Settings.
ADMIN_EMAIL=

# The site's public origin, used for canonical URLs, share previews, the
# sitemap and links inside emails. Defaults to https://thefieldwork.co.uk.
#
# IT ALSO NAMES THIS DEPLOYMENT TO STRIPE. Its host is written into the metadata
# of every Checkout Session opened here, and the webhook acts only on sessions
# carrying its own. One Stripe account serves the live site and every preview of
# it, and Stripe sends a completed session to EVERY endpoint on the account — so
# without that stamp a place bought on the preview arrives at production, whose
# database has never held that workshop, and gets read as a workshop withdrawn
# mid-checkout: refunded, with an apology emailed to a real buyer. It happened
# twice on 2026-08-14 (D-19).
#
# So on a preview this must be the preview's own address, not the live domain.
# Two deployments claiming the same origin are one deployment as far as this
# guard is concerned.
NEXT_PUBLIC_SITE_URL=

# --- PICTURES ----------------------------------------------------------------

# Where pictures Marianne uploads are KEPT. Set it to a Replit Object Storage
# bucket id, or to the word `default` to use the workspace's own bucket.
#
# WITHOUT IT they are written to app/public/media on local disk, which is
# right for development and WRONG on Replit: that filesystem does not survive
# a redeploy. It is the same failure that kept restoring the temporary admin
# password from a JSON file until the credential moved into Postgres — except
# that here it takes the photographs with it.
#
# Which store runs is decided by whether this is set, NOT by NODE_ENV, on the
# same rule as RESEND_API_KEY below.
#
# The photographs that ship with the code stay on disk and are served from it
# in both modes; a bucket holds only what she has added since.
MEDIA_BUCKET_ID=

# --- EMAIL -------------------------------------------------------------------

# Resend API key. WITHOUT IT the app still works: reset links are printed to the
# server log instead of being sent, clearly marked as not delivered. That is a
# deliberate dev adapter, not a silent failure — it lets the whole reset flow be
# built and tested before the sending domain is verified.
#
# Which adapter runs is decided by whether this key exists, NOT by NODE_ENV,
# because a production deploy with no key must not quietly pretend to send.
RESEND_API_KEY=

# The From address. Must be on a domain verified in Resend — until the DNS
# records are on the sending subdomain, Resend rejects anything else.
EMAIL_FROM="The Field Work <hello@thefieldwork.co.uk>"

# Where a booking notice goes — "somebody has booked, this is who, this is what
# is left". Defaults to marianne@thefieldwork.co.uk.
#
# Deliberately NOT read from her admin account: the email on an account is
# optional and stays empty until she fills it in on Settings, and a notice that
# a stranger has just paid £190 must not depend on whether she has been in
# there. Set this if the mailbox ever moves.
EMAIL_TO_OWNER=

# Where replies land. The domain has NO MX record, so nothing can receive mail
# at hello@thefieldwork.co.uk — a reply would bounce, and the sender reads that
# as being ignored. Mail still comes FROM the domain (which is what DKIM and
# DMARC align against); only the reply address differs. Point this at a real
# mailbox once one exists.
EMAIL_REPLY_TO=marianne@thefieldwork.co.uk

# --- PAYING FOR A PLACE ------------------------------------------------------

# Stripe. Places on a workshop are sold through Stripe's own hosted checkout —
# the card details are typed on Stripe's page, on Stripe's domain, and never
# touch this server. That is not a convenience, it is the promise printed on
# the workshop page: "You pay through Stripe. I never see your card details."
#
# BOTH OF THE FIRST TWO OR NEITHER. Buying is offered only when the secret key
# AND the webhook secret are both set. With the secret key alone a real card
# could be charged with nothing on this side able to confirm it — the buyer
# pays, no booking is written, no confirmation is sent, and the place is not
# held. So the half-configured state is treated as not configured, the panel
# keeps its honest "you cannot book this online yet", and the server log says
# which half is missing.
#
# Which way it works is decided by whether the keys exist, NOT by NODE_ENV, on
# the same rule as RESEND_API_KEY above.

# From the Stripe dashboard, Developers → API keys. Server-side only; it never
# reaches a browser. LIVE keys take real money — there is no separate switch in
# this app that makes a live key behave like a test one.
STRIPE_SECRET_KEY=

# Signs the webhook Stripe sends when a payment completes. THE WEBHOOK IS WHAT
# CONFIRMS A BOOKING — never the browser coming back from Stripe, which can be
# forged, abandoned or lost. Every payload arriving at /api/stripe/webhook is
# checked against this before it is read, and refused with a 400 if it does not
# verify; anyone can POST to that address.
#
# It is NOT in the dashboard for local work. `stripe listen` prints one that
# belongs to that session:
#
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
#
# Deployed, it is the signing secret of the endpoint you register at
# Developers → Webhooks (event: checkout.session.completed). The two are
# different secrets; the local one stops working when you stop the CLI.
STRIPE_WEBHOOK_SECRET=

# The publishable key, which is public by design and safe in a browser.
# NOTHING CURRENTLY READS IT: hosted checkout is a redirect, so the payment
# page is Stripe's and no Stripe script runs on this site at all. It is
# documented here because the dashboard hands the pair out together and the day
# anything is embedded on our own page — a card field, a payment element — this
# is what it will need.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- THE SECOND ACCOUNT ------------------------------------------------------

# A second admin, for testing the reset flow against a mailbox we control.
# It is seeded with NO USABLE PASSWORD — a random 32 bytes, discarded — so the
# only way in is a reset link to its address. A second account sharing the same
# guessable temporary password would be a second front door.
#
# Set ADMIN_TEST_USERNAME="" to stop it being created at all.
ADMIN_TEST_USERNAME=nagrom.1990@gmail.com
ADMIN_TEST_EMAIL=nagrom.1990@gmail.com
