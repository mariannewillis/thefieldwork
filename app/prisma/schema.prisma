// The Field Work — database schema.
//
// The admin credential came here first, from a JSON file, because a file does
// not survive a Replit redeploy and silently restored the temporary password
// every time the site was published.
//
// Workshops were the first offering to land, and bookings followed them.
// Courses came next — the same offering spread over a run of dates — and are
// now on sale too, on a deposit and a balance. Services came third, and are the
// last of the three kinds; they are now paid for as well, but only after
// Marianne has approved the request that asked for one. Subscribers and page
// content are still to come. Money is counted in PENCE as
// an Int everywhere it appears: 0.1 + 0.2 is not 0.3, and these figures are
// what somebody gets charged and refunded.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of the schema — it lives in
// prisma.config.ts for migrations, and reaches the client through a driver
// adapter. That also means no query-engine binary to ship, which is one less
// thing to go wrong on Replit's Nix environment.
datasource db {
  provider = "postgresql"
}

/// An admin account. There is normally one — this is a sole practitioner's
/// portal — but the model allows more so a second can exist for testing the
/// reset flow without touching hers, and so an assistant could be added later
/// without a migration.
model AdminUser {
  id                 Int     @id @default(autoincrement())
  username           String  @unique
  /// Optional ON PURPOSE. Password reset sends a link to this address, so an
  /// account with no verified address simply cannot be reset by email —
  /// which is safer than seeding a plausible-looking address that nobody
  /// actually controls. Marianne sets hers in Settings.
  email              String? @unique
  passwordHash       String
  /// Bumped on every credential change. Baked into each session token and
  /// checked on every request, so changing the password instantly invalidates
  /// every session issued before it.
  credentialVersion  Int     @default(1)
  /// True while the seeded temporary password is still in use.
  mustChangePassword Boolean @default(true)

  /// The secret in her calendar subscription address, /api/calendar/<token>.
  ///
  /// STORED IN THE CLEAR, and it is the one bearer token in this schema that
  /// is — every other one (`PasswordResetToken.tokenHash`,
  /// `Booking.cancellationTokenHash`, `ServiceRequest.payTokenHash`) keeps only
  /// a SHA-256, because the usable secret exists in an email and never has to
  /// be shown twice. This one does: Outlook and Google want an address she can
  /// look up and paste again months later, and a hash cannot produce one.
  ///
  /// What makes that acceptable is what the address can do. It is READ-ONLY —
  /// a GET that renders her diary as text and writes nothing — and it is
  /// rotatable from the Calendar screen, which mints a new token and kills
  /// every subscription made from the old one. It is not a session: it cannot
  /// reach the portal, change anything, or see a single card detail.
  ///
  /// Null until she asks for one. A feed nobody wanted should not exist.
  calendarFeedToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetTokens PasswordResetToken[]
}

/// A one-time password-reset link.
///
/// Only the HASH of the token is stored. Anyone who reads this table — a
/// backup, a support query, a leaked dump — still cannot use what they find,
/// because the link itself only ever existed in the email.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  /// Set the moment it is spent. A reset link works exactly once.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A workshop: one day, in one room, at one price, for a fixed number of
/// people. The fields are the ones the public page actually renders, in the
/// order it renders them — the page and the form that fills it in are the same
/// shape on purpose (docs/screens/webapp/workshop-detail.html).
model Workshop {
  id Int @id @default(autoincrement())

  /// The address the page lives at. Derived from the name when the workshop is
  /// created and editable afterwards, but people put this link in emails to
  /// each other, so changing it breaks something that already worked.
  slug String @unique
  name String

  /// The sentence under the title. It is ALSO the only description the
  /// workshops list shows, so it has to make sense with nothing around it.
  summary String

  /// The long body, as HTML. Only ever written by `src/lib/rich-text.ts` from
  /// what Marianne types — headings, paragraphs and bullets, everything else
  /// escaped. Storing HTML rather than her source keeps the page's render a
  /// straight read with no parsing at request time.
  bodyHtml String

  /// The DAY, with no time attached — a date, not a timestamp. A workshop's
  /// 20 September is 20 September wherever the server happens to be, and a
  /// TIMESTAMP would let a timezone move it to the 19th.
  date DateTime @db.Date

  /// Wall-clock times as she writes them, "10:00" / "16:30". They are the
  /// times in the room; attaching them to an instant would mean picking a
  /// timezone, and the only correct answer would be the room's own.
  startTime String
  endTime   String

  venueName String

  /// The written address, one line per line, as it is set on the page. Kept as
  /// prose rather than street/town/county columns because it is only ever
  /// displayed whole — nothing sorts or searches on it.
  addressLines String
  postcode     String

  /// The access notes — step-free, the toilet, the parking, the buses. One
  /// bullet per line. These are what people write to ask about, so they sit
  /// beside the address rather than inside the long body.
  gettingThere String

  /// Which saved place filled the four fields above, when one did.
  ///
  /// A note of where the address came from, not where it is read from. Nothing
  /// renders through this relation, and it is cleared the moment any of the
  /// four fields is edited by hand — because then the address on the page is
  /// no longer that venue's.
  venueId Int?
  venue   Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  /// How many the room takes. Since bookings landed this is ENFORCED rather
  /// than displayed: places sold are counted off it when a Checkout Session is
  /// opened and again when the payment is confirmed (D-16). Selling the
  /// eleventh place of ten is taking money for a chair that does not exist.
  capacity Int

  /// PENCE. Never a float — 0.1 + 0.2 is not 0.3, and this figure is what
  /// someone gets charged.
  priceGBP Int

  /// Days before the day that a place is still refundable in full. PER
  /// WORKSHOP, not a site-wide rule: 14 is what her others use, and one day
  /// may need different terms. 0 means it cannot be refunded at all, and the
  /// page says so rather than printing a date.
  refundDays Int @default(14)

  /// ── what it takes out of the diary ──────────────────────────────────────
  ///
  /// How long either side of the day is unavailable for a session, in MINUTES.
  /// Setting up, packing down, and getting there and back.
  ///
  /// PER WORKSHOP, not a site-wide margin, and that is the whole point: a
  /// ninety-minute evening talk in the garden room takes an hour either side; a
  /// full-day retreat two counties away takes the day. One global figure would
  /// be wrong for both, and would be wrong in the expensive direction — either
  /// selling her an hour she needs for driving, or refusing a morning she was
  /// free for.
  marginBeforeMinutes Int @default(0)
  marginAfterMinutes  Int @default(0)

  /// The whole day, rather than a margin around the hours.
  ///
  /// Its own column and not "margin = 1440", because it means something
  /// different and the form asks it as a different question. A retreat is not a
  /// two-hour workshop with a very large margin; it is a day that is gone. When
  /// this is true the two figures above are ignored, and the diary blocks
  /// midnight to midnight in LONDON — the day she means, not a UTC window that
  /// slides an hour in October.
  blocksWholeDay Boolean @default(false)

  /// The picture behind the title. Optional so a workshop can be written
  /// before there is a photograph for it, but required to publish — a page
  /// with no masthead is not the approved composition.
  ///
  /// Holds the media BASENAME, not a path: "marianne-room-aglow", from which
  /// the page builds `/media/<basename>-{1200,2400}.{avif,webp,jpg}`. The
  /// build-time image pipeline (D-6) emits six files per photograph and the
  /// page picks between them, so a single path would throw five away. Same
  /// shape `src/content/home.ts` already uses for the home page's plates.
  heroImage String?

  /// Required whenever heroImage is set. Enforced in the form, not by the
  /// database, because the two columns have to be checked against each other.
  heroAlt String?

  /// The one film, as a LINK to Vimeo or YouTube — the address she pasted, in
  /// its canonical form ("https://vimeo.com/76979871"). Nothing is uploaded
  /// here and nothing is transcoded: her source file is 604 MB, and the
  /// provider already does the encoding. The player's own address is derived
  /// from this at render by `src/lib/film.ts`, so a change of embed shape
  /// never needs a migration. Nullable because most workshops will not have
  /// one, and a player with nothing behind it is worse than no player.
  filmUrl      String?
  /// The still it opens on — a media BASENAME, like `heroImage`, not a path.
  /// NOT HERS TO TYPE: it is fetched from the provider when the link is saved
  /// and put through the same pipeline as everything else, so that opening a
  /// workshop's page contacts Vimeo or YouTube for nothing at all until
  /// somebody presses play. Null when the provider would not give one.
  filmPoster   String?
  /// As written, "0:42" — read off the provider, not typed. Vimeo reports a
  /// duration and YouTube does not, so this is null for a YouTube film and
  /// the page simply says less.
  filmDuration String?

  /// Whether it is on the site. Unpublished is not a draft-shaped second copy:
  /// there is one record, and this says whether the public can reach it.
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   WorkshopImage[]
  bookings Booking[]

  /// Both lists that exist — the public index and the portal's — read in date
  /// order, and both split on published.
  @@index([published, date])
}

/// A course: one purchase covering a run of dates, at one price, for a fixed
/// number of people. Everything it shares with a Workshop is spelled the same
/// way and means the same thing — the address is copied out of a Venue and
/// then owned by the course, money is PENCE as an Int, and the picture columns
/// hold media basenames rather than paths. The comments on Workshop above are
/// the reasoning for all of it and are not repeated here.
///
/// What makes it not a workshop is that it has no day of its own. The run is
/// CourseSession below, and the span the page prints — "Four Wednesdays ·
/// 7–28 Oct" — is read off those rows rather than stored here. Storing it
/// would be a second copy of something the dates already say, and the two
/// would disagree the first time one of them moved.
model Course {
  id Int @id @default(autoincrement())

  /// The address the page will live at, /courses/<slug>.
  slug String @unique
  name String

  /// The sentence under the title, and the only description the courses list
  /// shows.
  summary String

  /// The long body, as HTML, written by `src/lib/rich-text.ts` from what
  /// Marianne types.
  bodyHtml String

  /// Where the run happens, as it reads on the page. A single date can be
  /// somewhere else — see `CourseSession.venue` — and these four are what the
  /// course itself says.
  venueName    String
  addressLines String
  postcode     String
  gettingThere String

  /// Which saved place filled the four fields above, when one did. A note of
  /// where the address came from, not where it is read from; cleared the
  /// moment any of the four is edited by hand.
  venueId Int?
  venue   Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  /// How many the room takes. ENFORCED, as a workshop's is: counted off when a
  /// Checkout Session is opened and again under a row lock when the payment is
  /// confirmed (D-16). A place is committed by the DEPOSIT — the balance
  /// arriving later changes nothing about the room.
  capacity Int

  /// PENCE. The whole run, every date included — there is no way to buy one
  /// date of a course.
  priceGBP Int

  /// PENCE, and null when the whole price is taken at once the way a
  /// workshop's is. What the checkout charges: with a deposit set, buying a
  /// place takes this and the rest is owed by `balanceDueAt` below.
  depositGBP Int?

  /// When the rest of the price is due. HERS TO SET, per course, the same way
  /// `refundDays` is — this is not a site-wide "28 days before" rule the
  /// portal decided on her behalf.
  ///
  /// A DAY, with no time attached, for the reason `Workshop.date` gives. Null
  /// when there is no deposit and nothing is ever outstanding; required before
  /// a course with a deposit can go on the site, because a deposit with no
  /// date to settle by is an arrangement with no second half.
  ///
  /// It is COPIED onto each Booking as it is made. Moving it afterwards must
  /// not move the date somebody already bought on, which is the same reasoning
  /// that copies a venue's address onto the workshop rather than reading
  /// through the relation.
  balanceDueAt DateTime? @db.Date

  /// Days before the FIRST date that the run is still refundable in full. A
  /// course is bought once, so it is cancelled once.
  refundDays Int @default(14)

  /// ── what it takes out of the diary ──────────────────────────────────────
  ///
  /// The same three as a Workshop's, meaning the same thing, and on the COURSE
  /// rather than on each of its dates. A run is one arrangement — the same room,
  /// the same drive, the same packing up — so the margin around one Wednesday
  /// evening is the margin around all of them. Giving each CourseSession its own
  /// would be four copies of one answer, and the day she edited three of them
  /// would be the day the fourth was wrong.
  ///
  /// Applied to EVERY date of the run by `lib/availability.ts`.
  marginBeforeMinutes Int     @default(0)
  marginAfterMinutes  Int     @default(0)
  blocksWholeDay      Boolean @default(false)

  /// The picture behind the title, as a media basename, and the line saying
  /// what is in it. Required together, and required to publish.
  heroImage String?
  heroAlt   String?

  /// The one film, as a link to Vimeo or YouTube, with the still and the
  /// length read off the provider when the link is saved. Same three columns
  /// as Workshop, filled by the same code.
  filmUrl      String?
  filmPoster   String?
  filmDuration String?

  /// Whether it is on the site. Written and honoured here; the public courses
  /// pages are not built yet, so for the moment this decides what they will
  /// show rather than what anybody can see.
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   CourseImage[]
  sessions CourseSession[]
  bookings Booking[]

  /// Both lists that will exist — the portal's and the public index — split on
  /// published.
  @@index([published])
}

/// One date in a course's run.
///
/// `title` and `description` are here because the course's page gives every
/// date a name and a paragraph somebody can open. A row holding only a date
/// and two clock times would give the page nothing to expand into.
///
/// THERE IS NO SEQUENCE COLUMN, and dates are added and deleted but never
/// reordered. The order IS the date — in the portal, on the page, and in the
/// numbering the page prints. That removes a class of bug rather than solving
/// it: with a sequence integer beside a date there is a state where the two
/// disagree, a screen that has to say so, and a repair to design. Dates cannot
/// be out of order, so none of that exists.
model CourseSession {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// What this one is called — "Attention, and what it is not". Empty until
  /// she writes it; required before the course can go on the site.
  title String

  /// The DAY, with no time attached, for the reason Workshop.date gives.
  date DateTime @db.Date

  /// Wall-clock times as she writes them, "19:00" / "21:00".
  startTime String
  endTime   String

  /// The room, as written. The form offers the course's own place and she can
  /// overrule it for one date — a run that moves for a week is real, and it is
  /// the whole reason this is a column of its own rather than read off the
  /// course.
  venue String

  /// What happens on this one. Prose, as typed — not the ##/### markup the
  /// long body takes, because it is two or three sentences behind a line
  /// somebody opened, not a page.
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every read is in date order, which is the only order there is.
  @@index([courseId, date])
}

/// One picture in a course's stills rail. WorkshopImage, for courses — same
/// twelve-picture ceiling in application logic, same reasons.
model CourseImage {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// The media basename, as on `Course.heroImage`.
  url String

  /// NOT nullable. No picture goes on the site without a line saying what is
  /// in it.
  alt String

  /// The first three are what somebody sees before they scroll the rail, so
  /// the order is content, not presentation.
  position Int

  @@index([courseId, position])
}

/// Where a service happens. Two answers and no third.
///
/// `venue` — it happens somewhere of hers, at an address the page prints, the
/// same four fields a workshop and a course carry.
/// `travels` — she goes to the client, out to a distance she sets from a base
/// address.
///
/// It is a column rather than something inferred from which fields are filled
/// in, because "where is this?" has to have ONE answer on the public page and
/// the answer is a decision she makes, not a guess the page assembles from
/// what happens to be null. The branch not in force is emptied on every save
/// and the database refuses anything else — see the CHECK constraint
/// `Service_location_branch` in the add_services migration.
enum ServiceLocation {
  venue
  travels
}

/// A service: one person, one session, for as long as it takes.
///
/// The third and last kind of offering. What it shares with a Workshop and a
/// Course is spelled the same way and means the same thing — money is PENCE as
/// an Int, the picture columns hold media basenames rather than paths, the
/// film is a link with its still fetched once. The comments on Workshop above
/// are the reasoning for all of it and are not repeated here.
///
/// TWO THINGS A WORKSHOP HAS THAT THIS DOES NOT, and the reasons are the shape
/// of the thing rather than work left undone:
///
///  · NO DATE AND NO TIME. A visitor says when would suit them and she
///    answers; she does not set a day while writing the service. There is no
///    column here for one because there is no day.
///  · NO CAPACITY. One-to-one means one.
///
/// It is ASKED FOR rather than bought, and that is still true now that money
/// can change hands for one: a visitor sends a ServiceRequest, Marianne
/// approves it, and only then is a payment link sent. There is no price on this
/// row that a visitor can pay against — `priceGBP` is what the page says a
/// session costs, and what she is asked to approve is `ServiceRequest.approvedPence`
/// (D-25). Nothing here implies a checkout of its own.
model Service {
  id Int @id @default(autoincrement())

  /// The address the page will live at, /services/<slug>.
  slug String @unique
  name String

  /// The sentence under the title, and the only description the services list
  /// shows.
  summary String

  /// The long body, as HTML, written by `src/lib/rich-text.ts` from what
  /// Marianne types.
  bodyHtml String

  /// How long the session runs, in MINUTES. Minutes rather than a pair of
  /// clock times, because a service has no start: it has a length, and the
  /// start is whatever the visitor and she agree on. An hour and a quarter is
  /// 75, and the page reads it back in words.
  durationMinutes Int

  /// ── when she will do this one ───────────────────────────────────────────
  ///
  /// PER SERVICE, and that is a decision rather than an omission. A global
  /// working week was considered and rejected: she will drive to somebody on a
  /// Tuesday afternoon and will not do a two-hour session at eight in the
  /// morning, and one site-wide pattern would have to be the intersection of
  /// every service she offers — which is to say, the least she does anywhere.
  ///
  /// These four columns are read by `lib/availability.ts` and are never a list
  /// of slots. What a visitor is offered is COMPUTED from them, per request,
  /// against everything already in the diary. There is deliberately no table of
  /// bookable times: a stored list is a second copy of an answer the diary
  /// already gives, and it would be wrong from the moment a workshop moved.

  /// The days of the week she will do it, as ISO weekday numbers — 1 is Monday
  /// and 7 is Sunday. An array rather than seven booleans because the question
  /// is "which days" and the answer is a set; and because the form posts a set
  /// of checkboxes, which is the same shape.
  ///
  /// Monday to Friday is the DEFAULT, not a claim about her week. Every
  /// existing service got it at migration, because a service offering nothing
  /// is a form nobody can use — and the form says in as many words that these
  /// are a starting point. Empty is legal and means the honest thing: nothing
  /// is offered, and the page falls back to asking in words.
  availableDays Int[] @default([1, 2, 3, 4, 5])

  /// The earliest a session may START and the latest one may FINISH, as
  /// wall-clock times in her own day: "09:00", "17:00". Stored the way a
  /// workshop's `startTime` is, and for the same reason — these are the hours in
  /// the room, and attaching them to an instant would mean picking a timezone
  /// for a thing that repeats every week through two of them.
  ///
  /// `availableTo` is the FINISH, not the last start. Ninety minutes against a
  /// five o'clock finish means the last session starts at half past three, and
  /// that arithmetic is done once, in `lib/slots.ts`, so no screen has to.
  availableFrom String @default("09:00")
  availableTo   String @default("17:00")

  /// MINUTES kept clear before and after a session of this one, for getting
  /// there and getting back.
  ///
  /// Separate from `Workshop.marginBeforeMinutes` because it is a different
  /// kind of fact. A workshop's margin belongs to the workshop and blocks the
  /// diary for everything; a travel buffer belongs to the SERVICE BEING ASKED
  /// FOR and travels with the candidate slot. So the buffer is added to the
  /// slot a visitor is being offered rather than to what is already booked —
  /// which is why two sessions of a fifteen-minute-buffer service end up half
  /// an hour apart, and why that is right: fifteen minutes to get away from one
  /// and fifteen to get to the next is half an hour of driving, not a quarter.
  ///
  /// Zero by default, which is correct for a service that happens in her own
  /// room and never moves.
  travelBufferMinutes Int @default(0)

  /// The least warning she will take, in HOURS from now.
  ///
  /// 24 by default so that nobody books nine o'clock this morning at half past
  /// eight — the diary would say yes and she would find out when she opened it.
  /// Hours rather than days for the reason `APPROVAL_HOLD_HOURS` is hours:
  /// "tomorrow" from ten at night is twelve hours, not one day.
  ///
  /// PER SERVICE and editable, because an hour in the garden room and a
  /// half-day she drives to are not the same amount of notice. How far AHEAD
  /// she takes bookings is not here — that is `BOOKING_WINDOW_DAYS` in
  /// `lib/slots.ts`, one figure for the whole site, because it is a statement
  /// about how far into the future this diary is trusted rather than about any
  /// one service.
  minimumNoticeHours Int @default(24)

  /// Which of the two answers below is the live one. Exactly one branch is
  /// filled in; the other is null, on every save and by constraint.
  location ServiceLocation

  /// ── at a venue ──────────────────────────────────────────────────────────
  /// The same four fields as a workshop, and the same relation recording which
  /// saved place filled them. All null when she travels.
  venueName    String?
  addressLines String?
  postcode     String?
  gettingThere String?

  venueId Int?
  venue   Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  /// ── she travels ─────────────────────────────────────────────────────────
  /// Where she sets out from, and how far she will go. All null when it
  /// happens at a venue.
  ///
  /// The postcode is the one that matters — it is what a distance is measured
  /// from — so the lines above it can be empty. This is usually her own base
  /// rather than a room she teaches in, which is why it is not the venue
  /// picker.
  baseAddressLines  String?
  basePostcode      String?
  travelRadiusMiles Int?

  /// What travelling costs, IN HER OWN WORDS.
  ///
  /// DELIBERATELY PROSE, and there is no rate, no threshold and no surcharge
  /// column anywhere near it. She was asked whether travelling carries a
  /// charge and did not say, so anything structured here would be a pricing
  /// policy the portal invented on her behalf and then quietly enforced. A
  /// line she writes covers whatever her policy actually is — including not
  /// having one.
  ///
  /// If it turns out she wants mileage charged rather than described, that is
  /// a column and a checkout change made THEN, on what she tells us. Do not
  /// add a fee model to this on a guess.
  travelNote String?

  /// PENCE, for the session.
  priceGBP Int

  /// The picture behind the title, as a media basename, and the line saying
  /// what is in it. Required together, and required to publish.
  heroImage String?
  heroAlt   String?

  /// The one film, as a link to Vimeo or YouTube, with the still and the
  /// length read off the provider when the link is saved. Same three columns
  /// as Workshop, filled by the same code.
  filmUrl      String?
  filmPoster   String?
  filmDuration String?

  /// Whether it is on the site. /services lists the published ones and
  /// /services/<slug> answers 404 for the rest, exactly as a workshop's does.
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   ServiceImage[]
  requests ServiceRequest[]
  bookings Booking[]

  /// The portal's list and the public index, split on published.
  @@index([published])
}

/// One picture in a service's stills rail. WorkshopImage, for services — same
/// twelve-picture ceiling in application logic, same reasons.
model ServiceImage {
  id        Int     @id @default(autoincrement())
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// The media basename, as on `Service.heroImage`.
  url String

  /// NOT nullable. No picture goes on the site without a line saying what is
  /// in it.
  alt String

  /// The first three are what somebody sees before they scroll the rail, so
  /// the order is content, not presentation.
  position Int

  @@index([serviceId, position])
}

/// Where a request stands. THESE ARE THE ANSWERS SHE GAVE, and nothing else.
///
/// `pending` — it has arrived and she has not answered it.
/// `confirmed` — she approved it. The row then carries what she approved, by
///   when it must be paid, and the hash of the link that pays it.
/// `declined` — she said no, and the note she gave is on the row.
///
/// THERE IS STILL DELIBERATELY NO `expired`, and now for a stronger reason than
/// before. An approval that goes unpaid past its window lapses, but lapsing is
/// a CONSEQUENCE OF THE CLOCK rather than an answer anybody gave: it is
/// `payBy < now` with no Booking against the row, derived exactly as
/// `hasLapsed` is on a booking (D-23), true the moment it becomes true, and
/// needing nothing to fire. A fourth value here would be a column somebody —
/// or something scheduled — has to remember to set, and the morning it did not
/// run the row would say the approval was still live when it was not.
enum ServiceRequestStatus {
  pending
  confirmed
  declined
}

/// Somebody asking for a session, in their own words — and, once she has
/// answered, what she answered.
///
/// STILL NOT A BOOKING WHILE IT IS PENDING. Nothing is charged, nothing is
/// reserved and nothing is promised — §5, "a BookingRequest is not a booking".
/// It is a message with a service attached to it, and the answer comes from
/// Marianne rather than from this system.
///
/// WHAT APPROVING ADDS (D-25) is the second half of the columns below: what she
/// approved, when it happens in her words, by when it must be paid, and the
/// hash of the one link that pays it. A Booking appears only when Stripe says
/// the money arrived, exactly as it does for a workshop and a course — so the
/// row can say "approved and waiting", "approved and paid", or "approved and
/// nobody paid" without any of the three being a flag somebody sets.
model ServiceRequest {
  id Int @id @default(autoincrement())

  /// What they are asking for. Restrict, not cascade, for the reason
  /// `Booking.workshopId` gives: deleting a service somebody has written in
  /// about would take their message with it. The portal refuses the delete and
  /// says why.
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  name  String
  email String

  /// Optional, and it stays optional. Somebody who would rather not leave a
  /// number is not somebody to turn away at the form.
  phone String?

  /// THE SLOT THEY CHOSE — an instant, and the thing that decides everything.
  ///
  /// This is what D-24 said would arrive "as its own nullable pair of columns
  /// beside `preferredTime`" once availability existed, and it has. It is a real
  /// start and a real end, picked from times the server computed and re-checked
  /// on the way in (D-26), so unlike the sentence below it, it is a time
  /// something has actually looked at.
  ///
  /// UTC, RENDERED LONDON. Every instant in this database is UTC and this is no
  /// different, but it is the one that would hurt: the clocks go back on 25
  /// October, and a naive local-time store moves every autumn slot by an hour
  /// on the morning it happens. Stored as an instant, ten o'clock in Frome stays
  /// ten o'clock in Frome on both sides of the change.
  ///
  /// `slotEnd` is COPIED rather than derived from `Service.durationMinutes`, for
  /// the reason `Booking.balanceDueAt` is copied from the course: she may
  /// lengthen a service next month, and that must not silently lengthen an hour
  /// somebody already asked for and may already have been told about.
  ///
  /// NULL ON A REQUEST OLDER THAN THE CALENDAR, and on one made against a
  /// service that is offering nothing — see `preferredTime`. Nullable is the
  /// honest shape: those requests do not have a slot, and inventing one would
  /// put a time in her diary that nobody agreed to.
  slotStart DateTime?
  slotEnd   DateTime?

  /// WHEN WOULD SUIT THEM, AS THEY WROTE IT — their sentence, not their slot.
  ///
  /// NULLABLE NOW, and it is the pair above that made it so. A visitor who
  /// picked ten o'clock on Thursday did not write a sentence, and storing
  /// "Thursday at 10:00" here would be a second copy of `slotStart` that says
  /// the same thing in worse words and disagrees the first time one of them
  /// moves.
  ///
  /// It is still filled in, and still required, on the path that has no slot:
  /// a service with no days set, or one whose next sixty days are full. "Weekday
  /// mornings, not Tuesdays" is a real answer no picker can take, and it is the
  /// answer she needs in order to write back. The two operator requests that
  /// predate the calendar are on that path and are unchanged.
  ///
  /// Exactly one of the two is set. Nothing enforces that in the database,
  /// because a request with neither is a request that should not have been
  /// written and the form is what refuses it.
  preferredTime String?

  /// Anything else they want to say. Optional, as the approved form marks it
  /// — most people write nothing and the request is still worth answering.
  message String?

  status ServiceRequestStatus @default(pending)

  /// ── what she answered ───────────────────────────────────────────────────
  /// All null while it is pending, and all written in one transaction when she
  /// approves. Nullable rather than a second table because they are facts about
  /// THIS request — a request is answered once, and answering it again after it
  /// lapsed overwrites these rather than adding a row.

  /// When she approved it. Null on a request she has not answered, and on one
  /// she declined.
  approvedAt DateTime?

  /// PENCE, AS SHE APPROVED IT — not the service's list price.
  ///
  /// The default the form offers is `Service.priceGBP`, and she can change it
  /// before approving, because services carry travel and vary in length: a
  /// fixed figure would be wrong the first time she drives somewhere. What is
  /// stored here is what she actually agreed, and it is what the client is
  /// asked for and what the Booking's `totalPence` becomes. Editing the
  /// service's price next month must not change what somebody was already
  /// asked to pay, which is the same reasoning that copies a venue's address
  /// onto a workshop rather than reading through the relation.
  approvedPence Int?
  /// WHEN IT HAPPENS, IN HER WORDS. `preferredTime` above is the visitor's
  /// sentence; this is her answer to it — "Thursday 3rd at 10, at yours".
  ///
  /// TEXT, for exactly the reason `preferredTime` is text: there is no
  /// availability engine, no calendar and no slot, so a datetime here would be
  /// a time nothing had checked. When availability is built this becomes the
  /// prose beside a chosen slot rather than a thing to migrate.
  agreedTime    String?

  /// The SHA-256 of the token in the /pay/<token> link, never the token itself
  /// — the same rule as `Booking.balanceTokenHash` and for the same reason: the
  /// usable secret exists only in the email, so a leaked dump of this table
  /// cannot open a payment against anybody's session.
  ///
  /// Approving again after a lapse ISSUES A NEW ONE, which retires the link in
  /// the old email. That is the cost of not storing the token, and it is the
  /// right way round.
  payTokenHash String? @unique

  /// WHEN THE APPROVAL RUNS OUT. An instant, not a day: "48 hours from when she
  /// pressed approve" is what was promised, and a DATE would give somebody
  /// approved on Tuesday evening less than a day.
  ///
  /// COPIED HERE AT THE MOMENT OF APPROVAL from `APPROVAL_HOLD_HOURS`
  /// (src/lib/service-requests.ts), for the reason `Booking.balanceDueAt` is
  /// copied from the course: moving the window afterwards must not move a
  /// deadline somebody has already been told in writing.
  payBy DateTime?

  /// When she declined it, and what she said. The note is sent to them and kept
  /// here, so the queue can show what was said rather than only that something
  /// was.
  declinedAt  DateTime?
  declineNote String?

  /// The session they paid for, once they have. Written by the Stripe webhook
  /// and by nothing else.
  booking Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The queue reads oldest-unanswered-first within a status, which is the
  /// order she works in.
  @@index([status, createdAt])
  @@index([serviceId])
  /// Every read of the diary asks "what is claimed between these two instants?"
  /// and this is what answers it. Which of them are LIVE is arithmetic on top
  /// (D-26) rather than another column, for the reason there is no `expired`.
  @@index([slotStart])
}

/// Time she has taken out of her own diary, and the fifth thing that makes an
/// hour unavailable.
///
/// The other four are things somebody else can see — a workshop, a date in a
/// course, a session that has been paid for, a request holding its slot. This
/// one is hers: the school run, a funeral, a week in Wales, an afternoon she
/// simply does not want to work. It is made on the calendar, it is never
/// published, and no public page has ever read this table.
///
/// WHAT IT IS NOT is a second calendar. It holds no title, no attendees and no
/// repeat: `reason` is one line for her own eye, so that a stretch of grey in
/// October says WHY it is grey when she looks at it in September. A recurring
/// block would need an expansion, an exception list and a screen to manage
/// both, and nothing anybody has asked for needs one — a fortnight in Wales is
/// one row.
///
/// INSTANTS, not a day and two clock times, unlike everything else in this
/// schema that has a time on it. A workshop's day is a day and its times are
/// the times in the room; a block is a span of the diary, it is compared
/// directly against slots that are already instants, and half of them will not
/// start or end on a day boundary at all.
model PersonalBlock {
  id Int @id @default(autoincrement())

  /// UTC, rendered London. The whole of 25 October is exactly why: a block over
  /// the morning of the clock change is 25 hours of wall clock, and only an
  /// instant pair can say that without arguing with itself.
  startsAt DateTime
  endsAt   DateTime

  /// One line, in her words — "Dentist", "Wales". Required, and refusing a
  /// blank one is the same judgement `declineNote` makes: a grey stripe with
  /// nothing on it is a thing she will not recognise in three months and will
  /// not dare to delete.
  reason String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The calendar reads a month at a time, and availability reads a window.
  /// Both ask the same question of this column.
  @@index([startsAt])
}

/// What happened to the money. Three states, and no fourth: a place is either
/// held, or given up with the money returned, or given up without it.
///
/// `cancelledUnrefunded` covers TWO situations that look identical to the
/// ledger and different to the person — cancelled after the refund date, where
/// nothing is owed, and a refund we tried to make and could not. `CancelReason`
/// below is what tells them apart, which is why both columns exist.
enum BookingStatus {
  paid
  cancelledRefunded
  cancelledUnrefunded
}

/// Why the place was given up.
///
/// `buyer` is somebody using the link in their own confirmation email.
/// `soldOut` is the losing side of the race in D-16: two people paid for the
/// last place, one of them has no place, and the money goes back.
/// `marianne` is a cancellation made from the portal's bookings page — she is
/// ill, the day is off, or she has taken somebody out of the room herself.
///
/// The three are kept apart because a row that only said "cancelled" could not
/// answer the question she actually asks a month later: did they drop out, or
/// did I? It also decides what the buyer's email says, since "the place is free
/// for somebody else" is true when they cancelled and false when she did.
enum CancelReason {
  buyer
  soldOut
  marianne
}

/// A place somebody has paid for, on a workshop or on a course.
///
/// Written by ONE thing only — the Stripe webhook at
/// `app/api/stripe/webhook`, on a signature-verified `checkout.session.completed`.
/// Never by the browser coming back from Stripe: a success redirect can be
/// forged, abandoned or lost, and a booking that exists because a URL was
/// visited is a booking anybody can mint.
///
/// WHAT IS OWED IS HERE; WHAT CAME IN IS IN `Payment` BELOW. A workshop is one
/// payment and a course on a deposit is two, so the amount actually received is
/// the sum of its Payment rows and what is still outstanding is the difference.
/// Neither is a column, because a column would be a figure somebody has to keep
/// correct and arithmetic is not (D-23).
///
/// ONE OFFERING, AND EXACTLY ONE. Three nullable foreign keys with a CHECK
/// constraint rather than a `kind` column and a bare integer: this way every
/// relation is real, every one is `Restrict`, and the database can refuse a
/// booking that points at two of them — or at none. The constraint is written
/// as a sum precisely so that services could arrive as one more term in it,
/// which is what they did (D-25).
model Booking {
  /// Null when this is a course booking.
  workshopId Int?
  /// Restrict, not cascade. Deleting a workshop that people have paid for
  /// would delete the record of their money along with it; the portal refuses
  /// the delete instead and says why.
  workshop   Workshop? @relation(fields: [workshopId], references: [id], onDelete: Restrict)

  /// Null when this is a workshop booking. Restrict for the same reason.
  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  /// Null unless this is a session. Restrict for the same reason again.
  serviceId Int?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  /// WHICH APPROVAL THIS CAME FROM, and the reason a session booking has a
  /// fourth key when the other two have none.
  ///
  /// A workshop place is bought off the page by anybody; a session is bought
  /// only by the person Marianne approved, at the figure she approved, through
  /// the one link she sent. That link is a token on the ServiceRequest, so the
  /// approval — not the service — is what a payment is actually against.
  ///
  /// Set together with `serviceId` and null together with it, by
  /// `Booking_service_from_request`: a session booking with no approval behind
  /// it would be money taken for something nobody agreed to.
  ///
  /// UNIQUE, so one approval buys one session. Two checkout sessions opened
  /// from the same link race here and the second is refused by the row lock
  /// before it reaches this index; the index is the backstop that means it
  /// cannot happen even if that reasoning is wrong one day.
  serviceRequestId Int?            @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  id Int @id @default(autoincrement())

  /// As Stripe collected them at the checkout. We never ask for either on our
  /// own page — the whole promise of hosted checkout is that the card details,
  /// and the form they are typed into, are Stripe's.
  buyerName  String
  buyerEmail String

  places Int

  /// PENCE — WHAT THE WHOLE THING COSTS, every place included. Not what has
  /// been paid: a course bought on a deposit owes the rest of this until the
  /// balance lands. On a workshop it is both, because a workshop is paid at
  /// once.
  ///
  /// Worked out from the offering's own row at the moment the booking is made,
  /// and never afterwards — a price Marianne edits next month must not change
  /// what somebody already owes. The first payment's amount is compared
  /// against it on the way in and a difference is logged loudly.
  totalPence Int

  /// When the rest is due, COPIED from the course as it stood when the place
  /// was taken. Null when nothing was ever outstanding — every workshop
  /// booking, and a course with no deposit.
  ///
  /// This is what "overdue" is measured against, so it belongs to the booking
  /// rather than being read through the course: moving the course's own date
  /// afterwards must not move the date somebody already bought on.
  balanceDueAt DateTime? @db.Date

  status BookingStatus

  /// The SHA-256 of the token in the cancellation link, never the token
  /// itself — the same rule as PasswordResetToken above. The usable secret
  /// exists only in the buyer's email, so a leaked dump of this table cannot
  /// cancel anybody's place or move their money.
  ///
  /// Resending the link therefore ISSUES A NEW ONE rather than reprinting the
  /// old, which also retires the link in the old email. `issueLinkToken`
  /// in src/lib/bookings.ts is the only thing that writes this.
  cancellationTokenHash String @unique

  /// The SHA-256 of the token in the /pay/<token> link, on the same terms.
  /// Null when nothing was ever owed, because then there is no such link.
  ///
  /// A LINK OF OURS AND NEVER A STRIPE URL. A Checkout URL expires and becomes
  /// a dead end in somebody's inbox; this address does not, because the page
  /// behind it opens a fresh session on the click, and can also say "this was
  /// already paid" or "this place has been released" (D-23).
  balanceTokenHash String? @unique

  cancelledAt     DateTime?
  cancelledReason CancelReason?

  /// When the FIRST payment completed — the moment the place became theirs.
  /// What the receipt line on the confirmation page and in the email mean by
  /// "paid on 14 Aug". A second payment does not move it; it writes its own
  /// row below.
  paidAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  /// Places sold is `sum(places) where status = paid` for one offering, less
  /// anything lapsed, and it is read on every public workshop and course page.
  /// A service has no capacity — one-to-one means one — so its index is here to
  /// answer "has this service been paid for?" when one is about to be deleted.
  @@index([workshopId, status])
  @@index([courseId, status])
  @@index([serviceId, status])
}

/// What a payment was for. Three kinds and no fourth, because the operator's
/// decision is a deposit and a balance rather than instalments: `full` is the
/// whole price at once, which is every workshop and a course with no deposit.
/// Payment plans of n instalments are NOT this — they would need an ordering
/// and a schedule, and neither exists here.
enum PaymentKind {
  deposit
  balance
  full
}

/// Money that actually arrived.
///
/// One row per completed Checkout Session, written inside the same transaction
/// that records the Stripe event, so a redelivered webhook cannot make a second
/// row out of one payment — and neither can two different events, because
/// `stripeSessionId` is unique here exactly as it was on Booking before.
///
/// THE ARITHMETIC LIVES ON THESE ROWS. What has been paid is the sum of their
/// amounts; what is outstanding is the booking's total less that sum; whether
/// the money has gone back is whether every one of them carries a refund. None
/// of it is a boolean anybody has to remember to update.
model Payment {
  id        Int     @id @default(autoincrement())
  bookingId Int
  /// Cascade, unlike the offerings above. Deleting a booking is only ever
  /// reachable once it has been cancelled (D-18), and at that point the
  /// payments are the record OF that booking rather than a record of their own
  /// — the modal says in as many words that the payment reference goes with it.
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  kind PaymentKind

  /// PENCE, as Stripe reported the completed session — not as we recomputed
  /// it. What they were actually charged is what has to be refunded.
  amountPence Int
  /// Lowercase ISO, as Stripe writes it: "gbp".
  currency    String

  /// The checkout session this payment came from. Unique, so one session can
  /// only ever become one payment however many times Stripe delivers it.
  stripeSessionId       String  @unique
  /// What a refund is issued against. Nullable only because Stripe types it
  /// that way; a completed card session always has one.
  stripePaymentIntentId String?

  /// When Stripe says this one completed.
  paidAt DateTime

  /// What a refund needs to be traceable a year later, when somebody asks.
  ///
  /// PER PAYMENT, because a course refunded after both halves have landed is
  /// two refunds against two payment intents, and one column on the booking
  /// could hold only one of them. A refund is issued under the idempotency key
  /// `refund-payment-<id>`, so repeating the call returns the refund that
  /// already exists rather than moving money twice.
  refundId      String?
  refundedPence Int?
  refundedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A booking has at most one deposit, one balance and one full payment.
  /// The kinds are the arrangement, so two of a kind is not a thing that can
  /// be true — and this is what stops a second balance being taken if two
  /// checkouts were somehow opened from one link.
  @@unique([bookingId, kind])
  @@index([bookingId])
}

/// What the webhook DID with an event, decided under the workshop's lock.
///
/// Written for the paths that act, and the reason the column exists at all is
/// `workshopGone`: that path writes no Booking, so before this the row said
/// only that an event had arrived and there was no way to tell, a week later,
/// whether it had become a place or a refund. Four such rows already exist
/// against one Booking and nothing can now say what happened to the other
/// three (D-20).
///
/// It is the PATH TAKEN, not the result. Whether the refund actually went
/// through is Stripe's answer and it arrives after this transaction has
/// committed; it is in the log, and in the email Marianne gets, which says
/// REFUND DID NOT GO THROUGH in as many words. A column repeating that would
/// be a second place to keep in step with no second question to answer.
enum StripeEventOutcome {
  /// A paid Booking was written and the place is held.
  booked
  /// The losing side of the race in D-16 — a cancelled Booking was written and
  /// the money is chased.
  noPlace
  /// The workshop was gone by the time the payment was confirmed. No Booking
  /// to write; the payment is refunded and apologised for.
  workshopGone
  /// The course was gone by the time the payment was confirmed. The same path
  /// as `workshopGone` and a separate value because the two are different
  /// events a year later, and one name for both would answer neither.
  courseGone
  /// A balance landed on a course booking and settled it. Its own value rather
  /// than a second `booked`, because nothing was booked — a place that was
  /// already held stopped being owed for.
  settled
  /// A balance arrived for a booking there was nothing left to settle: it had
  /// been cancelled, or it had lapsed and the place had gone to somebody else.
  /// The payment is refunded and both people are told.
  balanceUnwanted
  /// Somebody paid for a session whose approval was no longer live — it had
  /// lapsed unpaid, or she had declined it, or she had withdrawn it and
  /// approved it again at a different figure. The payment is refunded and both
  /// people are told. Its own value rather than `noPlace`, because no place was
  /// ever the question: a session has no room and no capacity, and what ran out
  /// was the approval (D-25).
  approvalGone
  /// A SECOND payment arrived for a session that was already paid for — two
  /// checkout sessions opened from one link, both completed. The second is
  /// refunded. Its own value because it is the only outcome here that means
  /// somebody was charged twice, and that is the one a year later that has to
  /// be findable.
  duplicatePayment
}

/// A Stripe event we have already acted on.
///
/// Stripe retries a webhook until it gets a 2xx, and will happily deliver the
/// same event twice for reasons of its own — and the dashboard can replay one
/// by hand. The id goes in as the FIRST act of the transaction that confirms a
/// payment, before the workshop is even looked for, so every path that then
/// acts on the event is downstream of a committed row: a second delivery
/// collides on this primary key and does nothing at all. Not just one booking
/// per event — one refund, and one pair of emails (D-20).
///
/// Nothing prunes it yet. At a few hundred bookings a year that is a table of
/// a few hundred rows.
model StripeEvent {
  /// Stripe's own id, `evt_…`.
  id         String              @id
  type       String
  /// Null on the rows written before the column existed, and on nothing since.
  /// An outcome nobody recorded reads as unknown rather than as a guess.
  outcome    StripeEventOutcome?
  receivedAt DateTime            @default(now())
}

/// A place she has run something in, kept so that the same address does not
/// have to be typed again. Almost everything happens at The Garden Room.
///
/// It FILLS a workshop's own address columns and is never read instead of
/// them. That is the whole reason the same four fields exist in both places: a
/// workshop's address is what was true of the day it ran. Correcting the
/// parking note here must not rewrite the page of a workshop that has already
/// happened, and deleting a place must leave every workshop's address exactly
/// where it is — which is why the relation above is nullable and set null on
/// delete rather than cascading.
model Venue {
  id   Int    @id @default(autoincrement())
  name String

  /// Same shape as `Workshop.addressLines` — prose, one line per line,
  /// because the only thing either of them ever does is get displayed whole.
  addressLines String
  postcode     String

  /// The access notes, one bullet per line, as on the workshop.
  gettingThere String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workshops Workshop[]
  courses   Course[]
  /// Only the ones that happen AT a venue. A service she travels for records
  /// no place, because it did not come from one.
  services  Service[]
}

/// One picture in a workshop's stills rail.
///
/// Capped at TWELVE in application logic rather than by a constraint: the
/// limit is a judgement about how many a page carries before people stop
/// scrolling, not an integrity rule, and the message when it is reached has to
/// explain itself in her words.
model WorkshopImage {
  id         Int      @id @default(autoincrement())
  workshopId Int
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  /// The media basename, as on `Workshop.heroImage` — the page builds the
  /// six derivative URLs from it.
  url String

  /// NOT nullable. No picture goes on the site without a line saying what is
  /// in it — the form refuses, and the column refuses too.
  alt String

  /// The first three are what somebody sees before they scroll the rail, so
  /// the order is content, not presentation.
  position Int

  @@index([workshopId, position])
}

// ═══════════════════════════════════════════════════════════════════════════
// WHAT THE SITE SENDS
// ---------------------------------------------------------------------------
// Five models: the wording Marianne owns on the nine messages that reach a
// visitor, the people who asked for her letter, the letters themselves, what
// came attached to one, and who each one actually reached.
//
// The whole of this section is laid down in ONE migration on purpose. The
// screen that edits templates and the screens that write newsletters are built
// in two passes, and a schema that arrived in two pieces would have the second
// pass altering the first pass's tables while the first pass's screen was live.
// ═══════════════════════════════════════════════════════════════════════════

/// The three parts of one visitor-facing message that Marianne may reword.
///
/// ONE ROW PER MESSAGE, and only for the nine that reach a visitor. The six
/// notices that go to her own inbox are not here: they are read on a phone in a
/// hurry, plain text is the right shape for them, and branding an alarm is
/// decoration.
///
/// EVERY COLUMN IS NULLABLE, and that is the safety property rather than a
/// convenience. Null — or blank — means "as the app writes it", and the app's
/// own wording is branch-aware in a way one stored sentence cannot be: a
/// workshop confirmation, a course confirmation and a paid session say three
/// different true things. So a template she has never touched, and one she has
/// emptied, both send exactly what the app sent before this table existed.
///
/// WHAT IS NOT HERE IS THE POINT. There is no column for the amount, the date,
/// the venue, the deadline, the booking reference, the cancellation link or the
/// pay link. Those are emitted by code into blocks of their own, and nothing
/// she types reaches them — see src/lib/email/wording.ts.
model EmailTemplate {
  id Int @id @default(autoincrement())

  /// One of the nine keys in src/lib/email/wording.ts::EMAIL_TEMPLATE_KEYS.
  /// A string rather than an enum: the set is owned by that file, which also
  /// holds each one's seed wording and its placeholders, and splitting the
  /// definition across a migration and a module is how the two drift.
  key String @unique

  /// Her subject line. Newlines and control characters are stripped before it
  /// is ever handed to a transport — a subject is a header.
  subject String?
  /// The first thing the letter says, above every fact the code owns.
  opening String?
  /// The last thing it says, under them.
  signOff String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Somebody who asked for the monthly letter.
///
/// CONFIRMED IS A DATE, NOT A FLAG. PECR wants evidence of consent, and "true"
/// is not evidence — the day it happened is. Same for the leaving: a row is
/// never deleted when somebody unsubscribes, because deleting it loses the one
/// fact that proves they were taken off the list rather than never added.
model Subscriber {
  id Int @id @default(autoincrement())

  /// Stored lowercase and trimmed. The unique constraint is what stops one
  /// person appearing twice because they typed a capital.
  email String  @unique
  /// If they gave one. The form asks; it does not insist.
  name  String?

  joinedAt DateTime @default(now())

  /// When they confirmed, by pressing the link in the opt-in email. Null means
  /// they have not, and nothing is ever sent to a null.
  confirmedAt    DateTime?
  /// When they left. Null means they have not.
  unsubscribedAt DateTime?

  /// The secret in /unsubscribe/<token>.
  ///
  /// PER RECIPIENT AND STORED IN THE CLEAR, unlike the reset and cancellation
  /// tokens, which keep only a SHA-256. It has to be readable here because it
  /// is minted once and printed into every letter this person ever gets,
  /// including the `List-Unsubscribe` header Gmail and Apple Mail surface as a
  /// one-tap control. What it can do is why that is acceptable: a POST that
  /// stamps one date on one row and can do nothing else at all.
  unsubscribeToken String @unique

  sends NewsletterSend[]

  @@index([confirmedAt, unsubscribedAt])
}

enum NewsletterStatus {
  /// Hers to change, as often as she likes.
  draft
  /// Gone. Read-only from the moment the first message left.
  sent
}

/// A monthly letter — a draft she composes, or the record of one that went.
///
/// ONCE SENT IT IS LOCKED. Not because editing it would be difficult, but
/// because forty people are holding a copy of what it said, and a record that
/// can be changed after the fact is not a record. The screen offers to
/// DUPLICATE a sent letter into a new draft, which is what "edit last month's"
/// actually means.
model Newsletter {
  id Int @id @default(autoincrement())

  /// What it says in an inbox list, and the line under it.
  subject   String
  preheader String

  /// The eyebrow over the masthead — "The monthly letter · August".
  mastheadLabel String @default("The monthly letter")

  /// A picture from the media library to sit behind the masthead, or null.
  ///
  /// The basename only, exactly as a block's `imageBasename` is: the letter
  /// builds `/media/<basename>-1200.jpg` from it, because Outlook decodes
  /// neither of the two newer formats the site itself serves.
  ///
  /// DECORATION, AND NOTHING DEPENDS ON IT. Outlook for Windows renders through
  /// Word and ignores CSS backgrounds outright, so a large share of readers
  /// will never see it. The plum plate underneath is what carries every word.
  backgroundBasename String?

  status NewsletterStatus @default(draft)

  /// When the send started. Null while it is a draft.
  sentAt DateTime?

  /// How many people it was addressed to, frozen at send.
  ///
  /// Denormalised deliberately: the send rows below are the truth, but the list
  /// grows and shrinks afterwards and this is the number that was true on the
  /// day. Counting the rows a year later answers a different question.
  recipientCount Int @default(0)

  /// The letter this was duplicated from, if it was. Kept so a run of monthly
  /// letters can be read back as a run rather than as unrelated drafts.
  duplicatedFromId Int?
  duplicatedFrom   Newsletter?  @relation("NewsletterLineage", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates       Newsletter[] @relation("NewsletterLineage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks      NewsletterBlock[]
  attachments NewsletterAttachment[]
  sends       NewsletterSend[]

  @@index([status, sentAt])
}

/// The five parts a letter is made of.
///
/// Exactly the five the approved editor offers and exactly the five the
/// renderer can draw (docs/screens/admin/admin-newsletter-edit.html, and the
/// BLOCK markers in docs/screens/email/_build.mjs). A sixth kind is a change to
/// all three at once, which is what keeps them in step.
enum NewsletterBlockKind {
  heading
  paragraph
  image
  /// Pulls the live dates and prices at SEND time, not at compose time — a
  /// letter written on the 1st and sent on the 4th must not quote a place that
  /// went on the 2nd.
  offerings
  button
}

model NewsletterBlock {
  id           Int        @id @default(autoincrement())
  newsletterId Int
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  /// Where it sits. The order is content — the letter reads down the page.
  position Int
  kind     NewsletterBlockKind

  /// heading: the line. paragraph: the prose. button: the label.
  text String?

  /// image: the media basename, as everything else in this schema holds a
  /// picture — the URL is built from it. NOTE that a letter needs the `.jpg`
  /// derivative: Outlook for Windows renders neither AVIF nor WebP.
  imageBasename String?
  /// image: the line under it.
  caption       String?
  /// image: what somebody who cannot see it should be told. Never optional in
  /// the form, for the same reason WorkshopImage.alt is not.
  alt           String?

  /// button: where it goes. Absolute, or root-relative and made absolute at
  /// render time — an email has no document base.
  href String?

  /// offerings: how many to show. Null means everything that is open.
  count Int?

  @@unique([newsletterId, position])
  @@index([newsletterId])
}

/// Whether a file rides in the envelope or is fetched from a link in it.
enum AttachmentDelivery {
  /// Small enough to attach. It arrives with the letter.
  attached
  /// Too big to attach without hurting delivery. The letter carries a link and
  /// says what it is and how big.
  linked
}

/// A file Marianne put on one letter.
///
/// SELF-CONTAINED TO NEWSLETTERS on purpose. There is no Document model and the
/// documents screen is a stub; inventing a library here would be building the
/// wrong half of it, and a file uploaded to one letter belongs to that letter.
///
/// THE SIZE DECIDES HOW IT TRAVELS, not Marianne. Past a couple of megabytes an
/// attachment starts costing deliverability — greylisting, spam scoring, and
/// mailbox providers that refuse the message outright — so anything over the
/// threshold in src/lib/newsletter/attachments.ts becomes a link in the letter
/// instead. The screen says which is happening, in words, before she sends.
model NewsletterAttachment {
  id           Int        @id @default(autoincrement())
  newsletterId Int
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  /// What it is called in the letter and in the envelope. Her filename,
  /// cleaned — never used as a path.
  filename    String
  /// What it is called in the store. Prefixed and slugified, so two letters
  /// can each have a "notes.pdf" without one overwriting the other.
  storedAs    String @unique
  /// As sniffed from the bytes, not as the browser claimed.
  contentType String
  /// Its size, which is what decides `delivery`.
  bytes       Int

  delivery AttachmentDelivery

  /// The line under its name in the letter — "Six short exercises, one page
  /// each. A PDF, four pages."
  note String?

  createdAt DateTime @default(now())

  @@index([newsletterId])
}

/// Whether one letter reached one person.
enum NewsletterSendOutcome {
  /// Written before the attempt, so a crash mid-send leaves evidence rather
  /// than a gap.
  pending
  /// The provider accepted it. Not the same as "read", and never presented as
  /// such.
  delivered
  /// It did not go. `error` says what the provider said.
  failed
}

/// One letter, one person, one outcome.
///
/// A LETTER TO FORTY PEOPLE IS FORTY OUTCOMES, NOT ONE. A single "sent" flag on
/// the newsletter cannot answer the only question that matters the morning
/// after — did it reach Sarah — and a partial failure under one flag looks
/// exactly like a complete success.
model NewsletterSend {
  id           Int        @id @default(autoincrement())
  newsletterId Int
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  /// The subscriber, while they still exist. SetNull rather than Cascade: the
  /// record of what was sent must outlive somebody asking to be removed.
  subscriberId Int?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  /// The address it actually went to, frozen. Somebody can change theirs, and
  /// "we sent it to you" has to mean the address of the day.
  email String

  outcome NewsletterSendOutcome @default(pending)
  /// What the provider said, when it said no.
  error   String?
  /// When the provider accepted it.
  sentAt  DateTime?

  createdAt DateTime @default(now())

  /// One person is written to once per letter, whatever a retry does.
  @@unique([newsletterId, subscriberId])
  @@index([newsletterId, outcome])
}
