// The Field Work — database schema.
//
// One model for now: the admin credential. It moves here from a JSON file
// because a file does not survive a Replit redeploy, which silently restored
// the temporary password every time the site was published.
//
// Models for bookings, offerings, subscribers and page content land alongside
// it as each section of the portal is built.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of the schema — it lives in
// prisma.config.ts for migrations, and reaches the client through a driver
// adapter. That also means no query-engine binary to ship, which is one less
// thing to go wrong on Replit's Nix environment.
datasource db {
  provider = "postgresql"
}

/// An admin account. There is normally one — this is a sole practitioner's
/// portal — but the model allows more so a second can exist for testing the
/// reset flow without touching hers, and so an assistant could be added later
/// without a migration.
model AdminUser {
  id                 Int      @id @default(autoincrement())
  username           String   @unique
  /// Optional ON PURPOSE. Password reset sends a link to this address, so an
  /// account with no verified address simply cannot be reset by email —
  /// which is safer than seeding a plausible-looking address that nobody
  /// actually controls. Marianne sets hers in Settings.
  email              String?  @unique
  passwordHash       String
  /// Bumped on every credential change. Baked into each session token and
  /// checked on every request, so changing the password instantly invalidates
  /// every session issued before it.
  credentialVersion  Int      @default(1)
  /// True while the seeded temporary password is still in use.
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  resetTokens PasswordResetToken[]
}

/// A one-time password-reset link.
///
/// Only the HASH of the token is stored. Anyone who reads this table — a
/// backup, a support query, a leaked dump — still cannot use what they find,
/// because the link itself only ever existed in the email.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  /// Set the moment it is spent. A reset link works exactly once.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
