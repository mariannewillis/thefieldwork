# Replit configuration — thefieldwork
#
# The app lives in app/, not at the repo root, so every command cd's there.
#
# DEPLOYMENT TARGET IS "vm" (Reserved VM) ON PURPOSE — see below. Do not switch
# it to autoscale.

modules = ["nodejs-22"]
run = "cd app && npm run dev"

[nix]
channel = "stable-24_11"

# ── Deployment ───────────────────────────────────────────────────────────────
# deploymentTarget = "autoscale".
#
# This was "vm" (Reserved VM), chosen because Next's ISR cache is per-instance
# and a page Marianne published could otherwise appear on some requests and not
# others. Reserved VM turns out to need a paid Replit plan — selecting it makes
# the Publish button disappear — so autoscale it is.
#
# That is fine TODAY, and the reason is worth writing down rather than
# assuming: the public site currently has ZERO ISR. The homepage is fully
# static, prerendered at build (0 uses of revalidate / unstable_cache in
# src/), so there is no per-instance cache to disagree about. Sessions are
# stateless and signed with AUTH_SECRET, so they work across instances.
#
# TWO THINGS TO REVISIT when they land:
#
#  1. The login throttle in src/lib/auth/throttle.ts holds its counters IN
#     MEMORY, so each instance enforces its own allowance. On one instance
#     that is honest; across N instances a brute-force attempt gets roughly
#     5xN free guesses before any lockout, and lockouts do not propagate.
#     Moving those counters into Postgres fixes it.
#
#  2. When the editable-page CMS (D-2/D-3) makes the homepage database-backed,
#     it will want ISR — and per-instance caching becomes exactly the "I
#     published it and it is not showing" problem that picked Reserved VM in
#     the first place. Use on-demand revalidation deliberately, or revisit the
#     plan.
[deployment]
deploymentTarget = "autoscale"
# `prisma migrate deploy` applies any pending migration BEFORE the build.
# It only ever plays forward the migration files committed to the repo — it
# never invents a change from the schema, so a deploy cannot silently alter
# the database in a way nobody reviewed.
# --include=dev is deliberate: the build toolchain lives in devDependencies,
# and this makes the install correct even if NODE_ENV=production is set by
# the platform rather than by this file.
build = ["sh", "-c", "cd app && npm ci --include=dev && npx prisma migrate deploy && npm run build"]
run = ["sh", "-c", "cd app && npm run start"]

# Next binds the port Replit provides via $PORT (see app/package.json start).
[[ports]]
localPort = 3000
externalPort = 80

# NO [env] NODE_ENV HERE — ON PURPOSE.
#
# Setting NODE_ENV=production makes npm skip devDependencies, which silently
# omits the entire build toolchain: @tailwindcss/postcss, tailwindcss, the
# prisma CLI and typescript all live there. The failure is confusing, because
# package.json and the lockfile both list them correctly and `npm install`
# cheerfully reports "up to date" while node_modules/@tailwindcss is empty.
#
# It is also unnecessary. `next build` and `next start` both set
# NODE_ENV=production themselves. Verified rather than assumed: with NODE_ENV
# unset, the session cookie still comes back Secure — which is the one thing
# that would have mattered if Next did not.
